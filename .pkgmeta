package-as: Itinerary

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Itinerary_Data (GPL v3, its own add-on) comes in the same zip, as a folder of its own next to Itinerary
move-folders:
  Itinerary/Itinerary_Data: Itinerary_Data

ignore:
  - tools
  - docs
  - manual
  - README.md
  - MANUAL.md
  - CURSEFORGE.md
  - .gitignore

embedded-libraries:
  - libstub
  - callbackhandler
  - libdatabroker-1-1
  - libdbicon-1-0
