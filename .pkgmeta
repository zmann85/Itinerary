package-as: Itinerary

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1
  libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
  libs/HereBeDragons: https://repos.wowace.com/wow/herebedragons/trunk
  libs/LibDeflate: https://github.com/SafeteeWoW/LibDeflate
  libs/LibSerialize: https://github.com/rossnichols/LibSerialize

ignore:
  - tools
  - docs
  - manual
  - README.md
  - MANUAL.md
  - .gitignore
